{
	"info": {
		"_postman_id": "c85d852a-9e51-4f51-b8ef-827c81d29e71",
		"name": "Volunteer Hub API",
		"description": "Comprehensive Postman collection for the Volunteer Hub and Performance Tracking System. Covers authentication with session cookie management, automated CSRF token handling, and all endpoints for Volunteers, NGOs, and Platform Administrators.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Automatically extract XSRF-TOKEN cookie from jar and inject into xsrfToken variable",
					"const xsrfCookie = pm.cookies.get('XSRF-TOKEN');",
					"if (xsrfCookie) {",
					"    pm.variables.set('xsrfToken', decodeURIComponent(xsrfCookie));",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Store CSRF token if Set-Cookie header contains XSRF-TOKEN",
					"const xsrfCookie = pm.cookies.get('XSRF-TOKEN');",
					"if (xsrfCookie) {",
					"    pm.collectionVariables.set('xsrfToken', decodeURIComponent(xsrfCookie));",
					"}"
				]
			}
		}
	],
